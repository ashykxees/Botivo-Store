# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally or the Dashboard webhook endpoint (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: existing Stripe coupon to use for cancel-page win-back codes
STRIPE_WINBACK_COUPON_ID=

# Public URL of this site (used for Stripe redirects, OG tags, product images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/hgVYqZHxCS
NEXT_PUBLIC_SUPPORT_EMAIL=support@botivo.store

# Order notifications: the Botivo bot posts an embed for every paid order.
# Same token as the bot's TICKET_BOT_TOKEN; the bot needs View Channel + Send Messages in the order channel.
DISCORD_BOT_TOKEN=
# Server the buyer's Discord username is looked up in (for "in server?")
DISCORD_GUILD_ID=
# Channel that receives order embeds
DISCORD_ORDER_CHANNEL_ID=1551324617896099980

# Optional: currency (default usd)
STORE_CURRENCY=usd

# Stripe Price IDs (Dashboard → Product catalog → price → "price_..."). One-time prices, not recurring.
STRIPE_PRICE_NITRO_TOKENS_1M=
STRIPE_PRICE_NITRO_TOKENS_3M=
STRIPE_PRICE_DISCORD_NITRO_1M=
STRIPE_PRICE_DISCORD_NITRO_3M=
STRIPE_PRICE_SERVER_BOOSTS_1M=
STRIPE_PRICE_SERVER_BOOSTS_3M=

# Fallback prices (cents) used only when no Stripe Price ID is set
PRICE_NITRO_TOKENS_1M=249
PRICE_NITRO_TOKENS_3M=599
PRICE_DISCORD_NITRO_1M=599
PRICE_DISCORD_NITRO_3M=1499
PRICE_SERVER_BOOSTS_1M=349
PRICE_SERVER_BOOSTS_3M=899
